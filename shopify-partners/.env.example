# Shopify Partners API credentials
# Get these from https://partners.shopify.com -> Settings -> Partner API Clients

SHOPIFY_PARTNER_ID=851712
SHOPIFY_PARTNER_ACCESS_TOKEN=prtapi_<YOUR_32_CHAR_HEX_TOKEN>

# Optional: default app ID used when no appId argument is supplied
SHOPIFY_DEFAULT_APP_ID=

# Optional: override API version (default: 2024-10)
SHOPIFY_API_VERSION=2024-10
